[
  {
    "version": "v1.0",
    "createSurface": {
      "surfaceId": "${surfaceId}",
      "catalogId": "${catalogId}"
    }
  },
  {
    "version": "v1.0",
    "updateComponents": {
      "surfaceId": "${surfaceId}",
      "components": [
        {
          "id": "root",
          "component": "Column",
          "children": ["detail", "buttons"]
        },
        {
          "id": "detail",
          "component": "Text",
          "text": "${detail}"
        },
        {
          "id": "buttons",
          "component": "Row",
          "children": ["allow_button", "reject_button"]
        },
        {
          "id": "allow_button",
          "component": "Button",
          "child": "allow_label",
          "action": {
            "event": {
              "name": "${confirmAction}",
              "userMessage": "允许运行工具",
              "context": { "replyId": "${replyId}" }
            }
          }
        },
        {
          "id": "allow_label",
          "component": "Text",
          "text": "允许"
        },
        {
          "id": "reject_button",
          "component": "Button",
          "child": "reject_label",
          "action": {
            "event": {
              "name": "${rejectAction}",
              "userMessage": "拒绝运行工具",
              "context": { "replyId": "${replyId}" }
            }
          }
        },
        {
          "id": "reject_label",
          "component": "Text",
          "text": "拒绝"
        }
      ]
    }
  }
]
